// FROM logs-system.security-*
// | WHERE event.code == "4698" AND winlog.event_data.TaskContent RLIKE """(?i).*PT1M.*"""
// | KEEP @timestamp, host.name, winlog.event_data.TaskName, winlog.event_data.TaskContent
