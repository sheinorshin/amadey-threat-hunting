// Week 9 - export every event the SIEM recorded on the lab VM during the Atomic Red Team run
// (Kibana -> Discover -> ES|QL mode).
// 1. Set the time picker from 1 minute before the first test to 5 minutes after the last one
//    (the "Execution Time (UTC)" column of the Invoke-AtomicTest execution log, or utc_start in the run sheet).
// 2. Replace "lab-win" with the lab VM's host.name as Kibana shows it (lower case).
// 3. Run, then "Download" -> CSV  (or POST /_query?format=csv with this query in the body).
// 4. python scripts/score_atomic_run.py --runlog <execution log or run sheet> --events <this CSV> [--alerts <alerts CSV>]
//
// No text filter on purpose: atomics are not named like the Week 6 exercise, so the scorer ties events to tests by
// time window + process tree. The event codes are the ones the scorer can map to ATT&CK (03-siem-analysis.md §3.6).
// If a column is unknown in your cluster (e.g. no PowerShell data stream yet), delete it from KEEP.
FROM logs-*
| WHERE TO_LOWER(host.name) == "lab-win"
| WHERE event.code IN ("4688", "4104",                                       // process creation, script blocks
                       "4698", "4699", "4702",                               // scheduled task created/deleted/updated
                       "4720", "4722", "4724", "4726", "4732", "4733",       // accounts and local groups
                       "4946", "4947", "4948",                               // firewall rules
                       "1102", "4719", "7045")                               // log cleared, audit policy, new service
     OR (winlog.channel == "Microsoft-Windows-TaskScheduler/Operational"
         AND event.code IN ("100", "102", "106", "129", "140", "141", "200", "201"))
     OR (winlog.channel == "Microsoft-Windows-Windows Defender/Operational" AND event.code IN ("1116", "1117"))
  // once Sysmon is installed (Week 4/10 priority), add:
  // OR (data_stream.dataset == "windows.sysmon_operational" AND event.code IN ("1", "3", "10", "11", "13", "22"))
| KEEP @timestamp, host.name, event.code, data_stream.dataset, winlog.channel,
       process.pid, process.parent.pid, winlog.process.pid, process.name, process.parent.name, process.executable, process.command_line,
       user.name, winlog.event_data.TaskName, winlog.event_data.TaskContent,
       winlog.event_data.TargetUserName, winlog.event_data.MemberName, winlog.event_data.RuleName,
       powershell.file.script_block_text
  // with Sysmon also keep: registry.path, winlog.event_data.TargetImage
| SORT @timestamp ASC
| LIMIT 10000
