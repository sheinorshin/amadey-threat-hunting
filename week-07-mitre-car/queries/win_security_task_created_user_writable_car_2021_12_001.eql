any where (event.code like~ ("4698", "4702")) and (((winlog.event_data.TaskContent like~ ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*%APPDATA%*", "*%LOCALAPPDATA%*", "*%TEMP%*", "*%PUBLIC%*", "*%ProgramData%*", "*\\Windows\\Tasks\\*", "*\\Windows\\PLA\\System*", "*\\Registration\\CRMLog*", "*\\FxsTmp*", "*\\spool\\drivers\\color*", "*\\tracing\\*")) and (not winlog.event_data.TaskContent:"*\\ProgramData\\Microsoft\\Windows Defender\\*")) or winlog.event_data.TaskContent regex~ ".*c:\\\\users\\\\[^\\\\]+\\\\[^\\\\]+\\\\[^\\\\]+\\.exe.*" or (winlog.event_data.TaskContent:"*PT1M*" and (winlog.event_data.TaskContent like~ ("*javascript*", "*powershell*", "*wmic*", "*rundll32*", "*cmd*", "*cscript*", "*wscript*", "*regsvr32*", "*mshta*", "*bitsadmin*", "*certutil*", "*msiexec*", "*javaw*"))))
