any where (process.executable:"*\\schtasks.exe" or process.pe.original_file_name:"schtasks.exe") and (process.command_line like~ ("*/create*", "*/change*")) and (((process.command_line like~ ("*\\AppData\\*", "*\\Users\\Public\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*%APPDATA%*", "*%LOCALAPPDATA%*", "*%TEMP%*", "*%PUBLIC%*", "*%ProgramData%*", "*\\Windows\\Tasks\\*", "*\\Windows\\PLA\\System*", "*\\Registration\\CRMLog*", "*\\FxsTmp*", "*\\spool\\drivers\\color*", "*\\tracing\\*")) and (not process.command_line:"*\\ProgramData\\Microsoft\\Windows Defender\\*")) or process.command_line regex~ ".*c:\\\\users\\\\[^\\\\]+\\\\[^\\\\]+\\\\[^\\\\]+\\.exe.*" or (process.command_line regex~ ".*/sc[ ]+minute.*/mo[ ]+1([^0-9].*)?" and (process.command_line like~ ("*javascript*", "*powershell*", "*wmic*", "*rundll32*", "*cmd*", "*cscript*", "*wscript*", "*regsvr32*", "*mshta*", "*bitsadmin*", "*certutil*", "*msiexec*", "*javaw*"))))
