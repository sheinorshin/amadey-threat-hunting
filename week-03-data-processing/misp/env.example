# Copy into the cloned misp-docker folder as ".env" (on top of template.env values).
# Only the values we change for the lab are listed here.

BASE_URL=https://localhost:8443
NGINX_HTTP_PORT=8080          # avoid clashing with anything already on 80/443
NGINX_HTTPS_PORT=8443

ADMIN_EMAIL=admin@aitu.lab
ADMIN_ORG=AITU-CS2427
ADMIN_PASSWORD=               # set your own strong password (min. 12 chars) - never commit it
# ADMIN_KEY=                  # optional: 40-char API key; otherwise create one in the UI

TZ=Asia/Almaty

# Lab-size tuning (8 GB laptop): leave the rest of template.env at defaults
