any where (process.executable:"*\\schtasks.exe" or process.pe.original_file_name:"schtasks.exe") and (process.command_line:"*/Create*" and process.command_line:"*/SC MINUTE*" and process.command_line:"*/MO 1*" and process.command_line:"*/TR*") and (process.command_line like~ ("*\\AppData\\Local\\Temp\\*", "*\\AppData\\Roaming\\*", "*\\Users\\Public\\*"))
